# Public client storage key
NEXT_PUBLIC_CART_STORAGE_KEY="ish_portfolio_cart_v1"

# Optional payment & notification defaults (can also be configured in /admin -> Profile & Settings)
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
